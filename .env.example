# Copy to .env (git-ignored) and adjust. Used by docker-compose.yml and the API.

# Local Postgres (docker compose)
POSTGRES_DB=ink
POSTGRES_USER=ink
POSTGRES_PASSWORD=YOUR_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# API datasource (defaults in application.yml match the values above)
DB_URL=jdbc:postgresql://localhost:5432/ink
DB_USER=ink
DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# Owner login (seeded on API start; see README → "Owner login")
# OWNER_PASSWORD_HASH is a bcrypt hash from `./gradlew -q hashPassword`. Keep the single quotes:
# the hash contains `$`, which the shell would otherwise expand when this file is sourced.
OWNER_EMAIL=YOUR_EMAIL_HERE
OWNER_PASSWORD_HASH='YOUR_BCRYPT_HASH_HERE'

# Attachment storage (S3-compatible). Locally: the s3mock service in docker-compose.yml, which accepts
# any keys. In production: Cloudflare R2 (endpoint https://<account-id>.r2.cloudflarestorage.com,
# region auto, an R2 API token's keys).
S3MOCK_PORT=9090
STORAGE_ENDPOINT=http://localhost:9090
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ink-attachments
STORAGE_ACCESS_KEY=YOUR_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_STORAGE_SECRET_KEY

# ---------------------------------------------------------------------------------------------------
# Production (README → "Deploy"). These are set in Railway / GitHub, never in a committed file.
# Listed here, commented out, so every production variable has a placeholder.
#
# Railway — API service
# DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
# OWNER_EMAIL=YOUR_EMAIL_HERE
# OWNER_PASSWORD_HASH=YOUR_BCRYPT_HASH_HERE
# APP_CORS_ALLOWED_ORIGINS=https://YOUR_WEB_SERVICE.up.railway.app
# STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=YOUR_R2_BUCKET
# STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
# STORAGE_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
# (PORT is injected by Railway.)
#
# Railway — web preview service (Docker build arg, baked into the bundle)
# EXPO_PUBLIC_API_URL=https://YOUR_API_SERVICE.up.railway.app
#
# GitHub Actions (eas-update.yml): secret EXPO_TOKEN, variable API_URL
# EXPO_TOKEN=YOUR_EXPO_ACCESS_TOKEN
# API_URL=https://YOUR_API_SERVICE.up.railway.app
