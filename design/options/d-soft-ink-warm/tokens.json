{
  "$schema": "ink-design-tokens/v1",
  "name": "Ink · Soft ink + warmth",
  "notes": "All numbers are px and map 1:1 to React Native StyleSheet values. Shadows use RN iOS props plus Android elevation. Use logical start/end for RTL. Status dots always pair with a text label.",
  "colors": {
    "light": {
      "bg": "#F1EDE2",
      "surface": "#FBF8F3",
      "surfaceAlt": "#E8DFD0",
      "text": "#36291F",
      "textMuted": "#6B5A50",
      "border": "#E0D5C3",
      "borderStrong": "#B9A792",
      "primary": "#76544B",
      "onPrimary": "#FBF8F3",
      "primaryTint": "#E9DCD3",
      "accentLine": "#76544B",
      "danger": "#A2392E",
      "onDanger": "#FBF8F3",
      "success": "#3D7148",
      "statusAvailable": "#3F8050",
      "statusReserved": "#C46C1C",
      "statusDone": "#B23A2E",
      "scrim": "#36291F",
      "scrimOpacity": 0.4,
      "focus": "#76544B",
      "clientModeBg": "#76544B",
      "clientModeSurface": "#FBF8F3",
      "clientModeText": "#FBF8F3",
      "clientModeMuted": "#EADFD8",
      "accent": "#7A5472",
      "onAccent": "#FBF8F3",
      "accentTint": "#EEE2EA"
    },
    "dark": {
      "bg": "#211B18",
      "surface": "#2D2522",
      "surfaceAlt": "#3A302B",
      "text": "#F4EEE6",
      "textMuted": "#BEB0A4",
      "border": "#43382F",
      "borderStrong": "#65564B",
      "primary": "#D2B0A3",
      "onPrimary": "#211B18",
      "primaryTint": "#3F322C",
      "accentLine": "#D2B0A3",
      "danger": "#EE8E80",
      "onDanger": "#211B18",
      "success": "#8CC59A",
      "statusAvailable": "#7DC28E",
      "statusReserved": "#EDA762",
      "statusDone": "#F28A7D",
      "scrim": "#000000",
      "scrimOpacity": 0.6,
      "focus": "#D2B0A3",
      "clientModeBg": "#4A352F",
      "clientModeSurface": "#2D2522",
      "clientModeText": "#F4EEE6",
      "clientModeMuted": "#D9C9BF",
      "accent": "#D6AECB",
      "onAccent": "#211B18",
      "accentTint": "#3D2E38"
    }
  },
  "typography": {
    "fonts": {
      "heading": "Frank Ruhl Libre",
      "body": "Rubik",
      "numeric": "Rubik",
      "googleFonts": "https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700&family=Rubik:wght@400;500;600&display=swap",
      "expo": "Load with @expo-google-fonts; fontWeight is applied per loaded face."
    },
    "scale": {
      "display": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 36,
        "lineHeight": 42,
        "fontWeight": "500"
      },
      "title1": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 28,
        "lineHeight": 34,
        "fontWeight": "500"
      },
      "title2": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 21,
        "lineHeight": 28,
        "fontWeight": "500"
      },
      "headline": {
        "fontFamily": "Rubik",
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": "500"
      },
      "body": {
        "fontFamily": "Rubik",
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": "400"
      },
      "callout": {
        "fontFamily": "Rubik",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": "400"
      },
      "caption": {
        "fontFamily": "Rubik",
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": "400"
      },
      "overline": {
        "fontFamily": "Rubik",
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": "500",
        "letterSpacing": 0.4
      },
      "price": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 30,
        "lineHeight": 36,
        "fontWeight": "500"
      }
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 40,
    "screenPadding": 20,
    "rowHeight": 60
  },
  "radii": {
    "none": 0,
    "sm": 12,
    "md": 18,
    "lg": 26,
    "pill": 999
  },
  "borderWidth": {
    "hairline": 1,
    "strong": 1.5
  },
  "shadows": {
    "none": {
      "shadowColor": "#36291F",
      "shadowOffset": {
        "width": 0,
        "height": 0
      },
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "elevation": 0
    },
    "card": {
      "shadowColor": "#36291F",
      "shadowOffset": {
        "width": 0,
        "height": 4
      },
      "shadowOpacity": 0.07,
      "shadowRadius": 14,
      "elevation": 3
    },
    "raised": {
      "shadowColor": "#36291F",
      "shadowOffset": {
        "width": 0,
        "height": 8
      },
      "shadowOpacity": 0.1,
      "shadowRadius": 22,
      "elevation": 6
    },
    "modal": {
      "shadowColor": "#36291F",
      "shadowOffset": {
        "width": 0,
        "height": 20
      },
      "shadowOpacity": 0.22,
      "shadowRadius": 44,
      "elevation": 18
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "tabBar": 20,
    "backdrop": 100,
    "modal": 110,
    "toast": 200,
    "lock": 300
  },
  "touch": {
    "minTarget": 44,
    "buttonHeight": 52,
    "inputHeight": 52
  },
  "layout": {
    "phone": {
      "width": 393,
      "height": 852,
      "safeTop": 54
    },
    "tablet": {
      "width": 1180,
      "height": 820
    },
    "modalMaxWidth": {
      "phone": 353,
      "tablet": 460
    },
    "hourHeight": 58
  }
}
