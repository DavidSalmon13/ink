{
  "$schema": "ink-design-tokens/v1",
  "name": "Ink · Studio paper",
  "notes": "All numbers are px and map 1:1 to React Native StyleSheet values. Shadows use RN iOS props plus Android elevation. Use logical start/end for RTL. Status dots always pair with a text label.",
  "colors": {
    "light": {
      "bg": "#F1EDE2",
      "surface": "#F8F5EE",
      "surfaceAlt": "#E7E0D0",
      "text": "#2B211E",
      "textMuted": "#6A574F",
      "border": "#CDBFAA",
      "borderStrong": "#76544B",
      "primary": "#76544B",
      "onPrimary": "#F8F5EE",
      "primaryTint": "#E6DBD2",
      "accentLine": "#9C7B6E",
      "danger": "#9B3328",
      "onDanger": "#F8F5EE",
      "success": "#3F6E45",
      "statusAvailable": "#3F7A47",
      "statusReserved": "#B9671F",
      "statusDone": "#A3352B",
      "scrim": "#2B211E",
      "scrimOpacity": 0.45,
      "focus": "#76544B",
      "clientModeBg": "#2B211E",
      "clientModeSurface": "#3A2E2A",
      "clientModeText": "#F1EDE2",
      "clientModeMuted": "#CDBFB0"
    },
    "dark": {
      "bg": "#1D1816",
      "surface": "#272120",
      "surfaceAlt": "#322A27",
      "text": "#F1EDE2",
      "textMuted": "#BDAE9F",
      "border": "#4A3E39",
      "borderStrong": "#C9A99B",
      "primary": "#C9A99B",
      "onPrimary": "#1D1816",
      "primaryTint": "#3A2F2B",
      "accentLine": "#A88C7F",
      "danger": "#E58A7C",
      "onDanger": "#1D1816",
      "success": "#8DBB91",
      "statusAvailable": "#7DB883",
      "statusReserved": "#E3A15E",
      "statusDone": "#EB8478",
      "scrim": "#000000",
      "scrimOpacity": 0.6,
      "focus": "#C9A99B",
      "clientModeBg": "#F1EDE2",
      "clientModeSurface": "#F8F5EE",
      "clientModeText": "#2B211E",
      "clientModeMuted": "#6A574F"
    }
  },
  "typography": {
    "fonts": {
      "heading": "Frank Ruhl Libre",
      "body": "Assistant",
      "numeric": "Assistant",
      "googleFonts": "https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Assistant:wght@400;500;600;700&display=swap",
      "expo": "Load with @expo-google-fonts; fontWeight is applied per loaded face."
    },
    "scale": {
      "display": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 36,
        "lineHeight": 42,
        "fontWeight": "500"
      },
      "title1": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 28,
        "lineHeight": 34,
        "fontWeight": "500"
      },
      "title2": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 21,
        "lineHeight": 28,
        "fontWeight": "500"
      },
      "headline": {
        "fontFamily": "Assistant",
        "fontSize": 17,
        "lineHeight": 24,
        "fontWeight": "600"
      },
      "body": {
        "fontFamily": "Assistant",
        "fontSize": 17,
        "lineHeight": 26,
        "fontWeight": "400"
      },
      "callout": {
        "fontFamily": "Assistant",
        "fontSize": 15,
        "lineHeight": 22,
        "fontWeight": "400"
      },
      "caption": {
        "fontFamily": "Assistant",
        "fontSize": 13,
        "lineHeight": 18,
        "fontWeight": "500"
      },
      "overline": {
        "fontFamily": "Assistant",
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": "600",
        "letterSpacing": 1.2
      },
      "price": {
        "fontFamily": "Frank Ruhl Libre",
        "fontSize": 30,
        "lineHeight": 36,
        "fontWeight": "500"
      }
    }
  },
  "spacing": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64,
    "screenPadding": 24,
    "rowHeight": 64
  },
  "radii": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "pill": 999
  },
  "borderWidth": {
    "hairline": 1,
    "strong": 1.5
  },
  "shadows": {
    "none": {
      "shadowColor": "#2B211E",
      "shadowOffset": {
        "width": 0,
        "height": 0
      },
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "elevation": 0
    },
    "card": {
      "shadowColor": "#2B211E",
      "shadowOffset": {
        "width": 0,
        "height": 0
      },
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "elevation": 0
    },
    "raised": {
      "shadowColor": "#2B211E",
      "shadowOffset": {
        "width": 0,
        "height": 2
      },
      "shadowOpacity": 0.08,
      "shadowRadius": 6,
      "elevation": 2
    },
    "modal": {
      "shadowColor": "#2B211E",
      "shadowOffset": {
        "width": 0,
        "height": 12
      },
      "shadowOpacity": 0.18,
      "shadowRadius": 32,
      "elevation": 12
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "tabBar": 20,
    "backdrop": 100,
    "modal": 110,
    "toast": 200,
    "lock": 300
  },
  "touch": {
    "minTarget": 44,
    "buttonHeight": 50,
    "inputHeight": 50
  },
  "layout": {
    "phone": {
      "width": 393,
      "height": 852,
      "safeTop": 54
    },
    "tablet": {
      "width": 1180,
      "height": 820
    },
    "modalMaxWidth": {
      "phone": 353,
      "tablet": 460
    },
    "hourHeight": 62
  }
}
