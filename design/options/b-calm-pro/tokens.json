{
  "$schema": "ink-design-tokens/v1",
  "name": "Ink · Calm pro",
  "notes": "All numbers are px and map 1:1 to React Native StyleSheet values. Shadows use RN iOS props plus Android elevation. Use logical start/end for RTL. Status dots always pair with a text label.",
  "colors": {
    "light": {
      "bg": "#F7F5F1",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F1EDE2",
      "text": "#1E1A18",
      "textMuted": "#5F5550",
      "border": "#E2DCD1",
      "borderStrong": "#B9AEA0",
      "primary": "#76544B",
      "onPrimary": "#FFFFFF",
      "primaryTint": "#EFE6E1",
      "accentLine": "#76544B",
      "danger": "#A9322A",
      "onDanger": "#FFFFFF",
      "success": "#2E7049",
      "statusAvailable": "#2E7D4C",
      "statusReserved": "#C2690F",
      "statusDone": "#B3352B",
      "scrim": "#1E1A18",
      "scrimOpacity": 0.4,
      "focus": "#76544B",
      "clientModeBg": "#F1EDE2",
      "clientModeSurface": "#FFFFFF",
      "clientModeText": "#1E1A18",
      "clientModeMuted": "#5F5550"
    },
    "dark": {
      "bg": "#131110",
      "surface": "#1C1918",
      "surfaceAlt": "#262220",
      "text": "#F3EFE8",
      "textMuted": "#A99F97",
      "border": "#342F2C",
      "borderStrong": "#5A514C",
      "primary": "#C8A497",
      "onPrimary": "#131110",
      "primaryTint": "#2C2421",
      "accentLine": "#C8A497",
      "danger": "#EE8C80",
      "onDanger": "#131110",
      "success": "#7FC096",
      "statusAvailable": "#6FBF8A",
      "statusReserved": "#EBA35A",
      "statusDone": "#F08479",
      "scrim": "#000000",
      "scrimOpacity": 0.6,
      "focus": "#C8A497",
      "clientModeBg": "#262220",
      "clientModeSurface": "#1C1918",
      "clientModeText": "#F3EFE8",
      "clientModeMuted": "#A99F97"
    }
  },
  "typography": {
    "fonts": {
      "heading": "Heebo",
      "body": "Heebo",
      "numeric": "Heebo",
      "googleFonts": "https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap",
      "expo": "Load with @expo-google-fonts; fontWeight is applied per loaded face."
    },
    "scale": {
      "display": {
        "fontFamily": "Heebo",
        "fontSize": 28,
        "lineHeight": 34,
        "fontWeight": "700"
      },
      "title1": {
        "fontFamily": "Heebo",
        "fontSize": 22,
        "lineHeight": 28,
        "fontWeight": "700"
      },
      "title2": {
        "fontFamily": "Heebo",
        "fontSize": 17,
        "lineHeight": 22,
        "fontWeight": "600"
      },
      "headline": {
        "fontFamily": "Heebo",
        "fontSize": 15,
        "lineHeight": 20,
        "fontWeight": "600"
      },
      "body": {
        "fontFamily": "Heebo",
        "fontSize": 15,
        "lineHeight": 22,
        "fontWeight": "400"
      },
      "callout": {
        "fontFamily": "Heebo",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": "400"
      },
      "caption": {
        "fontFamily": "Heebo",
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": "500"
      },
      "overline": {
        "fontFamily": "Heebo",
        "fontSize": 11,
        "lineHeight": 14,
        "fontWeight": "600",
        "letterSpacing": 0.6
      },
      "price": {
        "fontFamily": "Heebo",
        "fontSize": 26,
        "lineHeight": 32,
        "fontWeight": "700"
      }
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 24,
    "xxxl": 32,
    "screenPadding": 16,
    "rowHeight": 52
  },
  "radii": {
    "none": 0,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "borderWidth": {
    "hairline": 1,
    "strong": 1.5
  },
  "shadows": {
    "none": {
      "shadowColor": "#1E1A18",
      "shadowOffset": {
        "width": 0,
        "height": 0
      },
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "elevation": 0
    },
    "card": {
      "shadowColor": "#1E1A18",
      "shadowOffset": {
        "width": 0,
        "height": 1
      },
      "shadowOpacity": 0.05,
      "shadowRadius": 2,
      "elevation": 1
    },
    "raised": {
      "shadowColor": "#1E1A18",
      "shadowOffset": {
        "width": 0,
        "height": 4
      },
      "shadowOpacity": 0.08,
      "shadowRadius": 10,
      "elevation": 3
    },
    "modal": {
      "shadowColor": "#1E1A18",
      "shadowOffset": {
        "width": 0,
        "height": 16
      },
      "shadowOpacity": 0.2,
      "shadowRadius": 40,
      "elevation": 16
    }
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "tabBar": 20,
    "backdrop": 100,
    "modal": 110,
    "toast": 200,
    "lock": 300
  },
  "touch": {
    "minTarget": 44,
    "buttonHeight": 44,
    "inputHeight": 44
  },
  "layout": {
    "phone": {
      "width": 393,
      "height": 852,
      "safeTop": 54
    },
    "tablet": {
      "width": 1180,
      "height": 820
    },
    "modalMaxWidth": {
      "phone": 353,
      "tablet": 460
    },
    "hourHeight": 50
  }
}
